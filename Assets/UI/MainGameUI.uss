/*
2026-05-12 AI-Tag
This was created with the help of Assistant, a Unity Artificial Intelligence product.
*/
.screen {
    flex-grow: 1;
    flex-direction: row;
    padding: 30px;
    background-color: rgba(0, 0, 0, 0);
    justify-content: space-between;
}

.panel {
    background-color: rgba(255, 255, 255, 0.95);
    border-radius: 25px;
    padding: 20px;
    border-width: 0;
    border-color: rgba(0, 0, 0, 0.05);
}

.left-panel {
    width: 240px;
    align-self: flex-start;
}

.right-panel {
    width: 280px;
    align-self: flex-start;
}

.label-title {
    font-size: 18px;
    color: #FF8C00;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.label-value {
    font-size: 42px;
    color: #333333;
    -unity-font-style: bold;
    margin-bottom: 25px;
}

.best-container {
    margin-top: 15px;
}

.label-best-title {
    font-size: 16px;
    color: #666666;
}

.label-best-value {
    font-size: 26px;
    color: #333333;
}

.next-container {
    align-items: center;
    margin-bottom: 25px;
}

.next-icon-frame {
    width: 100px;
    height: 100px;
    background-color: rgba(0, 0, 0, 0.05);
    border-radius: 20px;
    margin-top: 10px;
    justify-content: center;
    align-items: center;
}

.next-icon {
    width: 80px;
    height: 80px;
}

.evolution-chart {
    flex-grow: 1;
    margin-top: 15px;
}

.evolution-list {
    flex-direction: column;
}

.evolution-item {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.evolution-item-icon {
    width: 32px;
    height: 32px;
    margin-right: 12px;
}

.evolution-item-arrow {
    font-size: 14px;
    color: rgba(0, 0, 0, 0.3);
    margin-right: 12px;
}

.evolution-item-label {
    font-size: 16px;
    color: #444444;
}

/* GameOver Overlay */
.game-over-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.85);
    justify-content: center;
    align-items: center;
}

.label-game-over-title {
    font-size: 80px;
    color: #FF4444;
    -unity-font-style: bold;
    margin-bottom: 50px;
}

.game-over-score-container {
    align-items: center;
    margin-bottom: 50px;
}

.game-over-buttons {
    flex-direction: row;
}

.ui-button {
    width: 180px;
    height: 70px;
    background-color: #FFA633;
    color: white;
    font-size: 24px;
    -unity-font-style: bold;
    border-radius: 35px;
    margin: 15px;
    border-width: 0;
}

.ui-button:hover {
    background-color: #FFD27F;
}

.ui-button:active {
    background-color: #CC7A00;
}
